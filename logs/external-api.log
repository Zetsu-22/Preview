},\"mappings\":{\"links\":{\"self\":\"https://kitsu.io/api/edge/anime/42422/relationships/mappings\",\"related\":\"https://kitsu.io/api/edge/anime/42422/mappings\"}},\"reviews\":{\"links\":{\"self\":\"https://kitsu.io/api/edge/anime/42422/relationships/reviews\",\"related\":\"https://kitsu.io/api/edge/anime/42422/reviews\"}},\"mediaRelationships\":{\"links\":{\"self\":\"https://kitsu.io/api/edge/anime/42422/relationships/media-relationships\",\"related\":\"https://kitsu.io/api/edge/anime/42422/media-relationships\"}},\"characters\":{\"links\":{\"self\":\"https://kitsu.io/api/edge/anime/42422/relationships/characters\",\"related\":\"https://kitsu.io/api/edge/anime/42422/characters\"}},\"staff\":{\"links\":{\"self\":\"https://kitsu.io/api/edge/anime/42422/relationships/staff\",\"related\":\"https://kitsu.io/api/edge/anime/42422/staff\"}},\"productions\":{\"links\":{\"self\":\"https://kitsu.io/api/edge/anime/42422/relationships/productions\",\"related\":\"https://kitsu.io/api/edge/anime/42422/productions\"}},\"quotes\":{\"links\":{\"self\":\"https://kitsu.io/api/edge/anime/42422/relationships/quotes\",\"related\":\"https://kitsu.io/api/edge/anime/42422/quotes\"}},\"episodes\":{\"links\":{\"self\":\"https://kitsu.io/api/edge/anime/42422/relationships/episodes\",\"related\":\"https://kitsu.io/api/edge/anime/42422/episodes\"}},\"streamingLinks\":{\"links\":{\"self\":\"https://kitsu.io/api/edge/anime/42422/relationships/streaming-links\",\"related\":\"https://kitsu.io/api/edge/anime/42422/streaming-links\"}},\"animeProductions\":{\"links\":{\"self\":\"https://kitsu.io/api/edge/anime/42422/relationships/anime-productions\",\"related\":\"https://kitsu.io/api/edge/anime/42422/anime-productions\"}},\"animeCharacters\":{\"links\":{\"self\":\"https://kitsu.io/api/edge/anime/42422/relationships/anime-characters\",\"related\":\"https://kitsu.io/api/edge/anime/42422/anime-characters\"}},\"animeStaff\":{\"links\":{\"self\":\"https://kitsu.io/api/edge/anime/42422/relationships/anime-staff\",\"related\":\"https://kitsu.io/api/edge/anime/42422/anime-staff\"}}}},{\"id\":\"8674\",\"type\":\"anime\",\"links\":{\"self\":\"https://kitsu.io/api/edge/anime/8674\"},\"attributes\":{\"createdAt\":\"2014-08-10T15:46:45.846Z\",\"updatedAt\":\"2026-04-16T18:00:32.854Z\",\"slug\":\"shingeki-no-kyojin-kuinaki-sentaku\",\"synopsis\":\"Many years before becoming the famed captain of the Survey Corps, a young Levi struggles to survive in the capital's garbage dump, the Underground. As the boss of his own criminal operation, Levi attempts to get by with meager earnings while aided by fellow criminals, Isabel Magnolia and Farlan Church. With little hope for the future, Levi accepts a deal from the anti-expedition faction leader Nicholas Lobov, who promises the trio citizenship aboveground if they are able to successfully assassinate Erwin Smith, a squad leader of the Survey Corps.\\n\\nAs Levi and Erwin cross paths, Erwin acknowledges Levi's agility and skill and gives him the option to either become part of the expedition team, or be turned over to the Military Police, to atone for his crimes. Now closer to the man they are tasked to kill, the group plans to complete their mission and save themselves from a grim demise in the dim recesses of their past home. However, they are about to learn that the surface world is not as liberating as they had thought and that sometimes, freedom can come at a heavy price.\\n\\nBased on the popular spin-off manga of the same name, Shingeki no Kyojin: Kuinaki Sentaku illustrates the encounter between two of Shingeki no Kyojin's pivotal characters, as well as the events of the 23rd expedition beyond the walls.\\n\\n(Source: MAL Rewrite)\",\"description\":\"Many years before becoming the famed captain of the Survey Corps, a young Levi struggles to survive in the capital's garbage dump, the Underground. As the boss of his own criminal operation, Levi attempts to get by with meager earnings while aided by fellow criminals, Isabel Magnolia and Farlan Church. With little hope for the future, Levi accepts a deal from the anti-expedition faction leader Nicholas Lobov, who promises the trio citizenship aboveground if they are able to successfully assassinate Erwin Smith, a squad leader of the Survey Corps.\\n\\nAs Levi and Erwin cross paths, Erwin acknowledges Levi's agility and skill and gives him the option to either become part of the expedition team, or be turned over to the Military Police, to atone for his crimes. Now closer to the man they are tasked to kill, the group plans to complete their mission and save themselves from a grim demise in the dim recesses of their past home. However, they are about to learn that the surface world is not as liberating as they had thought and that sometimes, freedom can come at a heavy price.\\n\\nBased on the popular spin-off manga of the same name, Shingeki no Kyojin: Kuinaki Sentaku illustrates the encounter between two of Shingeki no Kyojin's pivotal characters, as well as the events of the 23rd expedition beyond the walls.\\n\\n(Source: MAL Rewrite)\",\"coverImageTopOffset\":230,\"titles\":{\"en\":\"Attack on Titan: No Regrets\",\"en_jp\":\"Shingeki no Kyojin: Kuinaki Sentaku\",\"ja_jp\":\"進撃の巨人 悔いなき選択\"},\"canonicalTitle\":\"Attack on Titan: No Regrets\",\"abbreviatedTitles\":[\"Shingeki no Kyojin: Birth of Levi\",\"Attack on Titan: No Regrets\"],\"averageRating\":\"82.37\",\"ratingFrequencies\":{\"2\":\"4055\",\"3\":\"75\",\"4\":\"183\",\"5\":\"65\",\"6\":\"161\",\"7\":\"52\",\"8\":\"4004\",\"9\":\"66\",\"10\":\"530\",\"11\":\"133\",\"12\":\"1019\",\"13\":\"198\",\"14\":\"9437\",\"15\":\"452\",\"16\":\"4656\",\"17\":\"688\",\"18\":\"3541\",\"19\":\"395\",\"20\":\"36840\"},\"userCount\":118015,\"favoritesCount\":179,\"startDate\":\"2014-12-09\",\"endDate\":\"2015-04-09\",\"nextRelease\":null,\"popularityRank\":70,\"ratingRank\":157,\"ageRating\":\"R\",\"ageRatingGuide\":\"17+ (violence & profanity)\",\"subtype\":\"OVA\",\"status\":\"finished\",\"tba\":nu